{
  "manifest_version": 2,
  "protocol_version": 1,
  "tool_id": "translate",
  "package_version": "1.1.5",
  "name": "文本翻译",
  "description": "纯本地中英互译，无需网址或密钥；在线服务可选。",
  "icon": "code",
  "category": "文字",
  "keywords": [
    "翻译",
    "中文",
    "英文",
    "translate"
  ],
  "min_host_version": "1.5.0",
  "actions": [
    {
      "id": "translate",
      "label": "翻译",
      "batch": false,
      "write_sources": false,
      "cancellable": true,
      "timeout_seconds": 180
    }
  ],
  "limits": {
    "max_files": 0,
    "max_input_bytes": 65536,
    "memory_mb": 512
  },
  "frontend": {
    "type": "web",
    "entry": "frontend/index.html",
    "bridge_version": 1,
    "state_version": 1,
    "capabilities": [
      "jobs",
      "clipboard",
      "export",
      "window",
      "state"
    ]
  }
}
