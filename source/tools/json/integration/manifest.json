{
  "manifest_version": 2,
  "protocol_version": 1,
  "tool_id": "json",
  "package_version": "1.2.3",
  "name": "JSON 工具",
  "description": "严格校验与保留精度的格式化。",
  "icon": "code",
  "actions": [
    {
      "id": "format",
      "label": "格式化",
      "batch": false,
      "write_sources": false,
      "cancellable": true,
      "timeout_seconds": 60
    },
    {
      "id": "validate",
      "label": "检查 JSON",
      "batch": false,
      "write_sources": false,
      "cancellable": true,
      "timeout_seconds": 60
    }
  ],
  "limits": {
    "max_files": 0,
    "max_input_bytes": 5242880,
    "memory_mb": 512
  },
  "category": "开发",
  "keywords": [
    "JSON",
    "格式化",
    "校验"
  ],
  "min_host_version": "1.4.0",
  "frontend": {
    "type": "web",
    "entry": "frontend/index.html",
    "bridge_version": 1,
    "state_version": 1,
    "capabilities": [
      "jobs",
      "files",
      "clipboard",
      "export",
      "window",
      "state"
    ]
  }
}
