{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModynToolbox executable manifest UI v2",
  "type": "object",
  "required": [
    "manifest_version",
    "protocol_version",
    "ui_schema_version",
    "tool_id",
    "name",
    "package_version",
    "view_file",
    "entry_program",
    "entry_args",
    "integrity_file",
    "integrity_sha256",
    "actions",
    "limits"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "protocol_version": {
      "const": 1
    },
    "ui_schema_version": {
      "const": 2
    },
    "min_host_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "icon": {
      "enum": [
        "files",
        "image",
        "code"
      ]
    },
    "view_file": {
      "const": "ui.json"
    },
    "entry_program": {
      "type": "string",
      "minLength": 1
    },
    "entry_args": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "integrity_file": {
      "const": "checksums.json"
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_files",
        "max_input_bytes",
        "memory_mb"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 2048
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "batch": {
            "type": "boolean"
          },
          "write_sources": {
            "type": "boolean"
          },
          "cancellable": {
            "type": "boolean"
          },
          "dynamic_resources": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "confirm": {
            "type": "string",
            "maxLength": 1024
          },
          "requires_context": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "category": {
      "type": "string",
      "maxLength": 40
    },
    "keywords": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  }
}
