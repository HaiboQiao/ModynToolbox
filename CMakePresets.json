{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-dev",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/.local/build/windows-dev",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MODYN_QT_ROOT}"
      }
    },
    {
      "name": "windows-check",
      "inherits": "windows-dev",
      "binaryDir": "${sourceDir}/.local/build/windows-check"
    },
    {
      "name": "windows-complete",
      "inherits": "windows-dev",
      "binaryDir": "${sourceDir}/.local/build/windows-complete"
    },
    {
      "name": "windows-release",
      "inherits": "windows-dev",
      "binaryDir": "${sourceDir}/.local/build/windows-release"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "configuration": "Debug"
    },
    {
      "name": "windows-check",
      "configurePreset": "windows-check",
      "configuration": "Debug"
    },
    {
      "name": "windows-complete",
      "configurePreset": "windows-complete",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-check",
      "configurePreset": "windows-check",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-complete",
      "configurePreset": "windows-complete",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
