{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-dev",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/.local/build/windows-dev",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{GRAPHITE_QT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}