{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GraphiteToolbox",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.local/build/windows-dev/bin/Debug/GraphiteToolbox.App.exe",
      "args": [
        "--data-root",
        "${workspaceFolder}/data",
        "--packages-root",
        "${workspaceFolder}/.local/installed/tools"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Graphite build",
      "console": "internalConsole"
    }
  ]
}
