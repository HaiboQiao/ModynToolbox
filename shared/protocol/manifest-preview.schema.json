{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog preview metadata",
  "description": "Early metadata subset. Full execution manifests are pending T02.",
  "type": "object",
  "required": [
    "manifest_version",
    "tool_id",
    "package_version",
    "name"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "icon": {
      "type": "string",
      "enum": [
        "image",
        "code",
        "files"
      ]
    },
    "view_file": {
      "const": "ui.json"
    }
  }
}
